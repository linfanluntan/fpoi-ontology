PREFIX fpoi:<https://w3id.org/fpoi/> SELECT ?obs ?verdict ?rxSource WHERE {?obs a fpoi:LongitudinalLesionObservation; fpoi:hasTargetCorrespondence ?a; fpoi:evaluatedAgainstDose ?dose . ?a fpoi:verdict ?verdict; fpoi:rxSource ?rxSource . FILTER(?verdict != "PASS") FILTER NOT EXISTS {?obs fpoi:interpretedAs ?fp}}